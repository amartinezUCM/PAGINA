---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/sections/PageHero.astro";
import BlockImageText from "@/components/sections/BlockImageText.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
---

<Layout
  title="Se Parte — UCM"
  description="Forma parte de UCM"
>
  <!-- ... (omitted earlier parts) ... -->

  <CTABanner
    label="¿Todo listo?"
    title="Solicita tu crédito"
    titleSerif="ahora"
    description="Sin costos de apertura, sin penalizaciones por pago anticipado. Solo condiciones justas y el respaldo de 32 años de experiencia."
    cta={{ label: "Solicitar crédito", href: "#" }}
    ctaSecondary={{ label: "Agendar asesoría gratis", href: "#" }}
    variant="surface"
    align="center"
  />

  <!-- Modals -->
  <ModalInversiones />
  <ModalCreditoEmpresarial />
  <ModalArrendamiento />
  <ModalAsesoriaPersonal />
</Layout>

<script>
  document
    .querySelectorAll<HTMLElement>(".reveal-up, .reveal-left, .reveal-right")
    .forEach((el) => {
      const isLeft = el.classList.contains("reveal-left");
      const isRight = el.classList.contains("reveal-right");
      el.style.opacity = "0";
      el.style.transform = isLeft
        ? "translateX(-30px)"
        : isRight
          ? "translateX(30px)"
          : "translateY(24px)";
      el.style.transition = "opacity 0.7s ease, transform 0.7s ease";
      const obs = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            const d = parseFloat(el.style.animationDelay || "0") * 1000;
            setTimeout(() => {
              el.style.opacity = "1";
              el.style.transform = "translate(0)";
            }, d);
            obs.disconnect();
          }
        },
        { threshold: 0.1 },
      );
      obs.observe(el);
    });
</script>
