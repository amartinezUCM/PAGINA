---
import FormModal from "./FormModal.astro";
---

<FormModal id="modal-credito-empresarial">
  <div class="mf-header">
    <h2 id="modal-credito-empresarial-title" class="mf-title">Crédito Empresarial</h2>
  </div>

  <form 
    class="mf-form" 
    id="form-credito-empresarial"
    name="modal-credito-empresarial" 
    novalidate
  >
    <!-- Nombre Completo -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ce-nombre">Nombre completo</label>
      <input
        class="mf-input"
        type="text"
        id="ce-nombre"
        name="entry.1136860981"
        autocomplete="name"
        required
      />
    </div>

    <!-- Empresa + Teléfono -->
    <div class="mf-row">
      <div class="mf-field">
        <label class="mf-label" for="ce-empresa">Empresa</label>
        <input
          class="mf-input"
          type="text"
          id="ce-empresa"
          name="entry.1308983442"
          autocomplete="organization"
          required
        />
      </div>
      <div class="mf-field">
        <label class="mf-label" for="ce-telefono">Teléfono</label>
        <input
          class="mf-input"
          type="tel"
          id="ce-telefono"
          name="entry.1724366045"
          autocomplete="tel"
          required
        />
      </div>
    </div>

    <!-- Monto + Correo -->
    <div class="mf-row">
      <div class="mf-field">
        <label class="mf-label" for="ce-monto">Monto aproximado</label>
        <input
          class="mf-input"
          type="text"
          id="ce-monto"
          name="entry.285676309"
          placeholder="Ej. $1,000,000"
        />
      </div>
      <div class="mf-field">
        <label class="mf-label" for="ce-correo">Correo</label>
        <input
          class="mf-input"
          type="email"
          id="ce-correo"
          name="entry.848312831"
          autocomplete="email"
          required
        />
      </div>
    </div>

    <!-- ¿Qué tipo de financiamiento? -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ce-financiamiento">¿Qué tipo de financiamiento necesitas?</label>
      <div class="mf-select-wrap">
        <select class="mf-select" id="ce-financiamiento" name="entry.1610242728" required>
          <option value="" disabled selected>Selecciona una opción</option>
          <option value="Capital de trabajo">Capital de trabajo</option>
          <option value="Expansión / apertura de sucursal">Expansión / apertura de sucursal</option>
          <option value="Adquisición de equipo">Adquisición de equipo</option>
          <option value="Compra de inmueble">Compra de inmueble</option>
          <option value="Refinanciamiento de deuda">Refinanciamiento de deuda</option>
          <option value="Otro">Otro</option>
        </select>
        <svg class="mf-select-icon" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
    </div>

    <!-- Mensaje -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ce-mensaje">Mensaje</label>
      <textarea
        class="mf-textarea"
        id="ce-mensaje"
        name="entry.1399869152"
        rows="4"
      ></textarea>
    </div>

    <div class="mf-footer">
      <button type="submit" class="mf-submit btn-primary">
        Enviar solicitud
      </button>
    </div>
  </form>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('form-credito-empresarial');
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const url = 'https://docs.google.com/forms/d/e/1FAIpQLSefVDm1e7re2KuoyIaKET8tl2_Qf-ptlpz-BswnqijoGT5lPQ/formResponse';
          
          try {
            await fetch(url, {
              method: 'POST',
              body: formData,
              mode: 'no-cors'
            });
            
            alert('¡Gracias! Tu solicitud ha sido enviada correctamente. Un asesor UCM se pondrá en contacto pronto.');
            
            form.reset();
            
            const modal = form.closest('.ucm-modal');
            if (modal) {
              modal.setAttribute('hidden', '');
            }
          } catch (error) {
            console.error('Error al enviar:', error);
            alert('Hubo un error al enviar el formulario. Por favor, intenta de nuevo.');
          }
        });
      }
    });
  </script>
</FormModal>
