---
import FormModal from "./FormModal.astro";
---

<FormModal id="modal-asesoria-personal">
  <div class="mf-header">
    <h2 id="modal-asesoria-personal-title" class="mf-title">Asesoría Personalizada</h2>
    <p class="mf-subtitle">Un asesor UCM te contactará para guiarte sin compromiso</p>
  </div>

  <form 
    class="mf-form" 
    id="form-asesoria-personal"
    name="modal-asesoria-personal" 
    novalidate
  >
    <!-- Nombre Completo -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ase-nombre">Nombre completo</label>
      <input
        class="mf-input"
        type="text"
        id="ase-nombre"
        name="entry.1242265541"
        autocomplete="name"
        required
      />
    </div>

    <!-- Empresa (opcional) -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ase-empresa">Empresa <span class="mf-optional">(opcional)</span></label>
      <input
        class="mf-input"
        type="text"
        id="ase-empresa"
        name="entry.1876581409"
        autocomplete="organization"
      />
    </div>

    <!-- Correo + Teléfono -->
    <div class="mf-row">
      <div class="mf-field">
        <label class="mf-label" for="ase-correo">Correo</label>
        <input
          class="mf-input"
          type="email"
          id="ase-correo"
          name="entry.355245236"
          autocomplete="email"
          required
        />
      </div>
      <div class="mf-field">
        <label class="mf-label" for="ase-telefono">Teléfono</label>
        <input
          class="mf-input"
          type="tel"
          id="ase-telefono"
          name="entry.875931888"
          autocomplete="tel"
          required
        />
      </div>
    </div>

    <!-- ¿En qué área necesitas asesoría? -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ase-area">¿En qué área necesitas asesoría?</label>
      <div class="mf-select-wrap">
        <select class="mf-select" id="ase-area" name="entry.810389931" required>
          <option value="" disabled selected>Selecciona una opción</option>
          <option value="Inversión a plazo fijo">Inversión a plazo fijo</option>
          <option value="Plan de ahorro">Plan de ahorro</option>
          <option value="Arrendamiento puro">Arrendamiento puro</option>
          <option value="Crédito PyME">Crédito PyME</option>
        </select>
        <svg class="mf-select-icon" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
    </div>

    <!-- Mensaje -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="ase-mensaje">¿Cómo podemos ayudarte?</label>
      <textarea
        class="mf-textarea"
        id="ase-mensaje"
        name="entry.598712729"
        rows="4"
        placeholder="Cuéntanos brevemente tu situación o necesidad..."
      ></textarea>
    </div>

    <div class="mf-footer">
      <button type="submit" class="mf-submit btn-primary">
        Solicitar asesoría
      </button>
    </div>
  </form>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('form-asesoria-personal');
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const url = 'https://docs.google.com/forms/d/e/1FAIpQLSeGHuYzfE6OlJ0ZdAH7gOTXUSNjukavGForkuNxOGAU6IY7sw/formResponse';
          
          try {
            await fetch(url, {
              method: 'POST',
              body: formData,
              mode: 'no-cors'
            });
            
            // Mostrar mensaje de éxito
            alert('¡Gracias! Tu solicitud ha sido enviada correctamente. Un asesor UCM se pondrá en contacto pronto.');
            
            // Limpiar formulario
            form.reset();
            
            // Cerrar modal
            const modal = form.closest('.ucm-modal');
            if (modal) {
              modal.setAttribute('hidden', '');
            }
          } catch (error) {
            console.error('Error al enviar:', error);
            alert('Hubo un error al enviar el formulario. Por favor, intenta de nuevo.');
          }
        });
      }
    });
  </script>
</FormModal>
