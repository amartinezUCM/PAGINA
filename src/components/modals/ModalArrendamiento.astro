---
import FormModal from "./FormModal.astro";
---

<FormModal id="modal-arrendamiento">
  <div class="mf-header">
    <h2 id="modal-arrendamiento-title" class="mf-title">Arrendamiento Puro</h2>
  </div>

  <form 
    class="mf-form" 
    id="form-arrendamiento"
    name="modal-arrendamiento" 
    novalidate
  >
    <!-- Nombre Completo -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="arr-nombre">Nombre completo</label>
      <input
        class="mf-input"
        type="text"
        id="arr-nombre"
        name="entry.2014635999"
        autocomplete="name"
        required
      />
    </div>

    <!-- Empresa + Teléfono -->
    <div class="mf-row">
      <div class="mf-field">
        <label class="mf-label" for="arr-empresa">Empresa</label>
        <input
          class="mf-input"
          type="text"
          id="arr-empresa"
          name="entry.1258605998"
          autocomplete="organization"
          required
        />
      </div>
      <div class="mf-field">
        <label class="mf-label" for="arr-telefono">Teléfono</label>
        <input
          class="mf-input"
          type="tel"
          id="arr-telefono"
          name="entry.152808874"
          autocomplete="tel"
          required
        />
      </div>
    </div>

    <!-- Correo + Monto -->
    <div class="mf-row">
      <div class="mf-field">
        <label class="mf-label" for="arr-correo">Correo</label>
        <input
          class="mf-input"
          type="email"
          id="arr-correo"
          name="entry.1403491316"
          autocomplete="email"
          required
        />
      </div>
      <div class="mf-field">
        <label class="mf-label" for="arr-valor">Valor aproximado del bien</label>
        <input
          class="mf-input"
          type="text"
          id="arr-valor"
          name="entry.949183775"
          placeholder="Ej. $800,000"
        />
      </div>
    </div>

    <!-- ¿Qué tipo de bien? -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="arr-tipo">¿Qué tipo de bien deseas arrendar?</label>
      <div class="mf-select-wrap">
        <select class="mf-select" id="arr-tipo" name="entry.1679187103" required>
          <option value="" disabled selected>Selecciona una opción</option>
          <option value="Vehículo de carga / flotilla">Vehículo de carga / flotilla</option>
          <option value="Maquinaria y equipo">Maquinaria y equipo</option>
          <option value="Tecnología / cómputo">Tecnología / cómputo</option>
          <option value="Equipo médico">Equipo médico</option>
          <option value="Otro">Otro</option>
        </select>
        <svg class="mf-select-icon" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
    </div>

    <!-- Mensaje -->
    <div class="mf-field mf-field--full">
      <label class="mf-label" for="arr-mensaje">Mensaje</label>
      <textarea
        class="mf-textarea"
        id="arr-mensaje"
        name="entry.522175611"
        rows="4"
      ></textarea>
    </div>

    <div class="mf-footer">
      <button type="submit" class="mf-submit btn-primary">
        Enviar solicitud
      </button>
    </div>
  </form>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('form-arrendamiento');
      
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const url = 'https://docs.google.com/forms/d/e/1FAIpQLSfzDp-X86bVMgas9g-JJ2XxwSavKgpQ9IikVLu8lwBERH95KA/formResponse';
          
          try {
            await fetch(url, {
              method: 'POST',
              body: formData,
              mode: 'no-cors'
            });
            
            alert('¡Gracias! Tu solicitud ha sido enviada correctamente. Un asesor UCM se pondrá en contacto pronto.');
            
            form.reset();
            
            const modal = form.closest('.ucm-modal');
            if (modal) {
              modal.setAttribute('hidden', '');
            }
          } catch (error) {
            console.error('Error al enviar:', error);
            alert('Hubo un error al enviar el formulario. Por favor, intenta de nuevo.');
          }
        });
      }
    });
  </script>
</FormModal>
