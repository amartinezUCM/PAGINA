---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white pt-20">
  <div class="max-w-[1280px] mx-auto">
    <div
      class="grid grid-cols-1 md:grid-cols-[1fr_20%_10%_20%] gap-y-8 md:gap-y-0 gap-x-4 p-5 md:px-40 md:py-14"
    >
      <!-- Brand + newsletter -->
      <div>
        <p class="text-sm font-[500] mb-4">Newsletter</p>
        <p class="text-xs leading-[1.55]">
          Los socios UCM tienen actualizaciones de promociones, servicios y
          eventos exclusivos de UCM. ¡Únete a nuestro Newsletter!
        </p>
        <!-- Newsletter form: submit to Google Forms in a hidden iframe so the page does not navigate away -->
        <form id="newsletter-form" class="flex mt-8 w-full" action="https://docs.google.com/forms/d/e/1FAIpQLSecFNR_7J2gtH4We4QZj63SzuXeXMWLyNgXlN73IbWVyHI7Cg/formResponse" method="POST" target="hidden_iframe" onsubmit="return handleNewsletterSubmit();">
          <input
            id="newsletter-email"
            name="entry.1234373129"
            type="email"
            placeholder="Tu correo electrónico"
            class="px-4 py-2 bg-black/6 border border-none rounded-l-lg text-black/70 text-xs focus:outline-none w-[70%]"
            required
          />
          <button
            id="newsletter-submit"
            type="submit"
            class="py-2 ml-1 bg-black/6 border border-none rounded-r-lg text-sm text-black/70 font-[500] cursor-pointer hover:bg-gold/80 transition-all duration-300 ease-in-out w-[28%]"
            aria-label="Suscribirse"
          >
            Suscríbete
          </button>
        </form>

        <!-- Hidden iframe to receive the Google Forms response so the main page doesn't navigate -->
        <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;"></iframe>

        <!-- Inline messages (kept as fallback) -->
        <div id="newsletter-status" style="display:none; margin-top:0.75rem;" class="text-sm font-medium text-green-600">
          ¡Gracias! Tu registro fue recibido.
        </div>
        <div id="newsletter-error" style="display:none; margin-top:0.75rem;" class="text-sm font-medium text-red-600">
          Ocurrió un error. Por favor inténtalo de nuevo más tarde.
        </div>

      </div>

      <!-- Empresa -->
      <div>
        <p class="text-sm font-[500] mb-4 tracking-tight">Compañia</p>
        <ul class="space-y-2 list-none p-0">
          <li style="display:none;">
            <a
              href="/"
              class="text-xs text-black/70 hover:text-black/50 transition-colors duration-300 ease-in-out"
            >
              Términos y Condiciones
            </a>
          </li>
          <li>
            <a
              href="https://drive.google.com/file/d/1dg66SaMocNXf9C6isKGay_tCQM3KeTrA/view"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-black/70 hover:text-black/50 transition-colors duration-300 ease-in-out"
            >
              Aviso de Privacidad
            </a>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <p class="text-sm font-[500] mb-4 tracking-tight">Social</p>
        <ul class="space-y-2 list-none p-0">
          {
            [
              { label: "Linkedin", href: "https://www.linkedin.com/company/uniondecreditomx/about/" },
              { label: "Facebook", href: "https://www.facebook.com/uniondecreditomx/?locale=es_LA" },
              { label: "Instagram", href: "https://www.instagram.com/uniondecreditomx/" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-black/70 hover:text-black/50 transition-colors duration-300 ease-in-out"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Recursos -->
      <div>
        <p class="text-sm font-[500] mb-4 tracking-tight">Recursos</p>
        <ul class="space-y-2 list-none p-0">
          <li>
            <a
              href="/legales"
              class="text-xs text-black/70 hover:text-black/50 transition-colors duration-300 ease-in-out"
            >
              Documentación
            </a>
          </li>
          <li>
            <a
              href="#"
              data-open-modal="modal-asesoria-personal"
              class="text-xs text-black/70 hover:text-black/50 transition-colors duration-300 ease-in-out"
            >
              Contáctanos
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<!-- Modal: Thank you (hidden by default) -->
<div id="newsletter-modal" class="fixed inset-0 hidden items-center justify-center z-50">
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative bg-white rounded-[1rem] max-w-md w-[90%] p-6 z-60">
    <h3 class="text-xl font-semibold mb-2">¡Gracias por suscribirte!</h3>
    <p class="text-sm text-gray-700 mb-4">Tu registro fue recibido. Te avisaremos de nuestras novedades.</p>
    <div class="flex justify-end">
      <button id="newsletter-modal-close" class="btn-primary px-4 py-2">Cerrar</button>
    </div>
  </div>
</div>

<script>
  // Newsletter submission handling: use hidden iframe to avoid navigation and show a modal thank-you
  (function () {
    const form = document.getElementById('newsletter-form');
    const emailInput = document.getElementById('newsletter-email');
    const submitBtn = document.getElementById('newsletter-submit');
    const statusEl = document.getElementById('newsletter-status');
    const errorEl = document.getElementById('newsletter-error');
    const iframe = document.getElementById('hidden_iframe');
    const modal = document.getElementById('newsletter-modal');
    const modalClose = document.getElementById('newsletter-modal-close');
    let timeoutId = null;
    let autoCloseId = null;

    if (!form) return;

    function showModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.style.display = 'flex';
      // Auto close after 5 seconds
      autoCloseId = setTimeout(hideModal, 5000);
    }

    function hideModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.style.display = 'none';
      if (autoCloseId) clearTimeout(autoCloseId);
    }

    // When the iframe loads, consider the submission complete
    iframe.addEventListener('load', () => {
      clearTimeout(timeoutId);
      // reset form UI
      submitBtn.disabled = false;
      submitBtn.textContent = 'Suscríbete';
      emailInput.value = '';

      // show modal thank-you
      showModal();

      // hide inline messages if any
      if (statusEl) statusEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
    });

    window.handleNewsletterSubmit = function () {
      // Reset messages
      if (statusEl) statusEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';

      // Basic client-side validation
      if (!emailInput.value || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(emailInput.value)) {
        if (errorEl) {
          errorEl.textContent = 'Introduce un correo válido.';
          errorEl.style.display = 'block';
        }
        return false; // prevent submit
      }

      // Disable submit and show a pending state
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      // Start a timeout: if iframe doesn't load within 8s, show error
      timeoutId = setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Suscríbete';
        if (errorEl) {
          errorEl.textContent = 'No se pudo completar el registro. Intenta nuevamente.';
          errorEl.style.display = 'block';
        }
      }, 8000);

      // Show a temporary status message
      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.textContent = 'Gracias. Procesando tu registro...';
      }

      return true; // allow normal form submit to iframe
    };

    // Close modal handlers
    if (modalClose) modalClose.addEventListener('click', hideModal);
    if (modal) modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
  })();
</script>
